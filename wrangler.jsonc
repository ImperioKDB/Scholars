{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "scholars",
  "main": "worker.ts",
  "compatibility_date": "2026-11-21",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  "queues": {
    "producers": [
      { "binding": "BROADCAST_EMAIL_QUEUE", "queue": "scholars-broadcast-email" },
      { "binding": "BROADCAST_PUSH_QUEUE", "queue": "scholars-broadcast-push" }
    ],
    "consumers": [
      { "queue": "scholars-broadcast-email", "max_batch_size": 1, "max_batch_timeout": 1, "max_retries": 2 },
      { "queue": "scholars-broadcast-push", "max_batch_size": 1, "max_batch_timeout": 1, "max_retries": 2 }
    ]
  },
  "keep_vars": true,
  "previews": {},
  "secrets": {
    "required": [
      "UPSTASH_REDIS_REST_TOKEN",
      "SUPABASE_SERVICE_ROLE_KEY",
      "BREVO_API_KEY",
      "RESEND_API_KEY",
      "WEB_PUSH_VAPID_PRIVATE_KEY",
      "CRON_SECRET"
    ]
  }
}

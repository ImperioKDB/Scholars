NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Deadline-reminder cron (app/api/cron/deadline-check) — see that file for
# details. Missing BREVO_API_KEY/REMINDER_FROM_EMAIL runs it in dry-run mode
# (evaluates + logs, sends nothing) rather than failing.
CRON_SECRET=
BREVO_API_KEY=
REMINDER_FROM_EMAIL=
DEADLINE_REMINDER_DAYS=

# Auto-apply draft generation (app/api/applications/[id]/draft) — used to
# draft a personal statement from the student's profile + the scholarship's
# requirements. Uses Google Gemini's free tier (no card required) — get a
# key at https://aistudio.google.com/apikey. Server-only, never exposed to
# the browser. Without it, draft generation returns a 502 with "Missing
# GEMINI_API_KEY env var" but everything else on the platform keeps working.
GEMINI_API_KEY=

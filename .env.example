NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Deadline-reminder cron (app/api/cron/deadline-check) — see that file for
# details. Missing BREVO_API_KEY/REMINDER_FROM_EMAIL runs it in dry-run mode
# (evaluates + logs, sends nothing) rather than failing.
CRON_SECRET=
BREVO_API_KEY=
REMINDER_FROM_EMAIL=
DEADLINE_REMINDER_DAYS=
# Optional ops alerting (app/api/cron/deadline-check): a Slack-style
# incoming webhook URL. When the cron finishes with any per-phase failures
# (and email is configured), it POSTs a one-line summary here. Unset =
# skipped silently, same dry-run-safe pattern as BREVO_API_KEY.
CRON_ALERT_WEBHOOK_URL=
# Upstash Redis (lib/ratelimit.ts) -- shared rate limiting across all
# serverless instances. Create a free account + database at
# https://upstash.com (free tier: 10k commands/day, no card required), then
# copy the REST URL and REST token from the database detail page. If unset,
# rate limiting skips silently (dry-run-safe), same pattern as BREVO above.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Auto-apply draft generation (app/api/applications/[id]/draft) — used to
# draft a personal statement from the student's profile + the scholarship's
# requirements. Uses Google Gemini's free tier (no card required) — get a
# key at https://aistudio.google.com/apikey. Server-only, never exposed to
# the browser. Without it, draft generation returns a 502 with "Missing
# GEMINI_API_KEY env var" but everything else on the platform keeps working.
GEMINI_API_KEY=

# Public browser configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=

# Server-only Supabase access
SUPABASE_SERVICE_ROLE_KEY=

# Set true only after every intended administrator has enrolled and verified
# a TOTP factor. This gates admin APIs and the admin server-component layout.
REQUIRE_ADMIN_MFA=false

# Required in production for shared security-sensitive rate limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Server-only email delivery configuration
BREVO_API_KEY=
REMINDER_FROM_EMAIL=

# Server-only scheduled-job configuration
CRON_SECRET=
CRON_ALERT_WEBHOOK_URL=
DEADLINE_REMINDER_DAYS=7

# Server-only profile reminder configuration
PROFILE_REMINDER_INTERVAL_DAYS=30
PROFILE_REMINDER_MAX_SENDS=3

# Server-only AI draft generation configuration
GEMINI_API_KEY=
